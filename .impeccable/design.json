      "css": ".ds-version{display:inline-flex;align-items:center;border-radius:4px;border:1px solid var(--color-stone-600,#4b453c);background:var(--color-stone-800,#211f1c);color:var(--color-stone-200,#e1d9ca);padding:4px 6px;font-family:var(--font-mono,\"Geist Mono\",monospace);font-size:.78rem;line-height:1;text-decoration:none;transition:color 150ms,border-color 150ms}.ds-version:hover{border-color:var(--color-gold-700,#654421);color:var(--color-gold-300,#f0d8a7)}.ds-version:focus-visible{outline:2px solid var(--color-gold-400,#dcad5c);outline-offset:5px;}"
    },
    {
      "name": "Directory card",
      "kind": "card",
      "refersTo": "project-card",
      "description": "An engraved link surface for factual project records.",
      "html": "<a class=\"ds-card\" href=\"#\"><span class=\"ds-card-meta\">Mod / Vanilla-plus</span><h3 class=\"ds-card-title\">Project name</h3><p class=\"ds-card-copy\">A concise project summary with compatibility and status recorded alongside it.</p><span class=\"ds-card-version\">1.13c</span></a>",
      "css": ".ds-card{position:relative;display:flex;flex-direction:column;padding:24px;border:1px solid #473724;background:linear-gradient(135deg,#201a12,#13120f 70%);text-decoration:none;color:var(--color-stone-300,#c5bcac);font-family:var(--font-sans,\"Barlow Semi Condensed\",system-ui,sans-serif);transition:color 150ms,background-color 150ms,border-color 150ms}.ds-card:before,.ds-card:after{position:absolute;content:\"\";width:7px;height:7px;color:#a1804d;pointer-events:none}.ds-card:before{left:3px;top:3px;border-top:1px solid;border-left:1px solid}.ds-card:after{right:3px;bottom:3px;border-bottom:1px solid;border-right:1px solid}.ds-card:hover{background:#251e14;border-color:var(--color-gold-700,#654421)}.ds-card:focus-visible{outline:2px solid var(--color-gold-400,#dcad5c);outline-offset:5px;}.ds-card-meta{font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:var(--color-stone-400,#aca18f)}.ds-card-title{margin:20px 0 0;font-family:var(--font-display,Cinzel,Georgia,serif);font-size:20px;font-weight:600;line-height:1.375;color:var(--color-gold-300,#f0d8a7)}.ds-card:hover .ds-card-title{color:var(--color-stone-100,#f3eee4)}.ds-card-copy{margin:12px 0 16px;font-size:16px;line-height:1.625}.ds-card-version{align-self:flex-start;padding:4px 6px;border:1px solid var(--color-stone-600,#4b453c);border-radius:4px;background:var(--color-stone-800,#211f1c);color:var(--color-stone-200,#e1d9ca);font-family:var(--font-mono,\"Geist Mono\",monospace);font-size:.78rem;line-height:1}"
    },
    {
      "name": "Desktop navigation",
      "kind": "nav",
      "refersTo": "desktop-nav",
      "description": "Tracked navigation with a gold active underline.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main\"><a href=\"#\" aria-current=\"page\">Play</a><a href=\"#\">Mods</a><a href=\"#\">Servers</a><a href=\"#\">Tools</a></nav>",
      "css": ".ds-nav{display:flex;gap:23px;background:#0e0e0c;border-block:1px solid #433321;padding-inline:16px}.ds-nav a{position:relative;display:flex;align-items:center;min-height:80px;color:#b8ac97;font-family:var(--font-sans,\"Barlow Semi Condensed\",system-ui,sans-serif);font-size:13px;font-weight:500;letter-spacing:.075em;text-transform:uppercase;text-decoration:none;transition:color 180ms}.ds-nav a:hover,.ds-nav a[aria-current]{color:#f0d8a7}.ds-nav a[aria-current]:after{content:\"\";position:absolute;bottom:0;inset-inline:0;height:2px;background:#bb8e4b}.ds-nav a:focus-visible{outline:2px solid var(--color-gold-400,#dcad5c);outline-offset:5px;}"
    },
    {
      "name": "Navigation path",
      "kind": "nav",
      "refersTo": "path-link",
      "description": "Bordered route tile with a compact two-level label.",
      "html": "<a class=\"ds-path\" href=\"#\"><svg width=\"29\" height=\"29\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" aria-hidden=\"true\"><path d=\"M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z\"/></svg><span><span class=\"ds-path-title\">Discover mods</span><span class=\"ds-path-copy\">A familiar world. New possibilities.</span></span><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-path{display:flex;align-items:center;gap:17px;padding:27px 20px;border:1px solid #3b3022;background:linear-gradient(#1c1913,#13120f);color:#b79862;text-decoration:none;transition:background-color 180ms}.ds-path:hover{background:#292115}.ds-path:focus-visible{outline:2px solid var(--color-gold-400,#dcad5c);outline-offset:5px;}.ds-path>svg{flex-shrink:0}.ds-path>svg:last-child{margin-left:auto}.ds-path-title{display:block;color:#dfc99e;font-family:var(--font-display,Cinzel,Georgia,serif);font-size:14px;font-weight:500}.ds-path-copy{display:block;margin-top:5px;color:#aa9e88;font-family:var(--font-sans,\"Barlow Semi Condensed\",system-ui,sans-serif);font-size:13px}"
    }
  ],
  "narrative": {
    "northStar": "The Monastery Gateway",
    "overview": "The visual world is a dark monastery gateway: weathered stone, blackened iron, antique gold lettering, and restrained oxblood actions. The user requested a Diablo website identity; classic Diablo II was the stated implementation assumption after the optional era question went unanswered. This document records that built direction, not a separately approved visual comp.\n\nCinematic artwork introduces the world; precise typography and restrained ornament carry the reference material. Display lettering feels engraved, UI copy stays compact and scannable, and long articles use a warmer book serif. Dark tonal layers and thin metal-colored borders provide structure without turning every content block into a raised panel.",
    "keyCharacteristics": [
      "Original gothic environment and still-life artwork, served locally as optimized WebP.",
      "Antique gold Cinzel titles, condensed Barlow UI, Source Serif 4 reading text.",
      "Squared iron-and-oxblood controls with fine bevels, corner marks, and diamond rules.",
      "Compatibility, project status, and source metadata remain legible within the atmosphere."
    ],
    "rules": [
      {
        "name": "The Reading Surface Rule",
        "body": "Illustration establishes atmosphere at entrances; reading and comparison happen on quiet dark surfaces.",
        "section": "colors"
      },
      {
        "name": "The Engraved Hierarchy Rule",
        "body": "Reserve Cinzel for headings and deliberate actions; use the reading and UI families for sustained information.",
        "section": "typography"
      },
      {
        "name": "The Still World Rule",
        "body": "The artwork may reveal once, then remains still; hover feedback changes color without displacing the interface.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Cinzel for display and section titles, Barlow Semi Condensed for UI, Source Serif 4 for articles, and Geist Mono for version strings.",
      "Do keep text over imagery on a dark shade and verify the mobile crop independently.",
      "Do retain visible focus, textual status labels, and reduced-motion behavior.",
      "Do preserve original raster provenance next to every shipped image.",
      "Do keep directory cards, compatibility badges, and verification notes factual and easy to scan."
    ],
    "donts": [
      "Don't use decorative display lettering for long article paragraphs.",
      "Don't replace the square iron surfaces with pill cards or soft floating panels.",
      "Don't place detailed illustration behind dense reference text.",
      "Don't introduce looping ambient motion; the shipped hero settles after one light reveal.",
      "Don't imply that generated illustrations or the custom mark are official Blizzard assets."
    ]
  }
}
